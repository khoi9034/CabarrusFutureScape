{
  "name": "cabarrusfuturescape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assets:arcgis": "node -e \"const f=require('node:fs'),d='public/arcgis-assets/esri/geometry/support',w='public/arcgis-assets/esri/core/workers';f.mkdirSync(d,{recursive:true});f.mkdirSync(w,{recursive:true});f.copyFileSync('node_modules/@arcgis/core/assets/esri/geometry/support/pe-wasm.wasm',d+'/pe-wasm.wasm');f.copyFileSync('node_modules/@arcgis/core/assets/esri/core/workers/RemoteClient.js',w+'/RemoteClient.js');f.cpSync('node_modules/@arcgis/core/assets/esri/core/libs/libtess','public/arcgis-assets/esri/core/libs/libtess',{recursive:true});f.cpSync('node_modules/@arcgis/core/assets/esri/widgets/Zoom/t9n','public/arcgis-assets/esri/widgets/Zoom/t9n',{recursive:true})\"",
    "predev": "npm run assets:arcgis",
    "prebuild": "npm run assets:arcgis",
    "dev": "next dev -p 3000",
    "dev:cfs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cfs-local.ps1",
    "present:cfs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cfs-presentation.ps1",
    "stop:cfs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-cfs-local.ps1",
    "build": "next build --webpack",
    "check:acceptance": "node scripts/check-product-acceptance.mjs",
    "check:demo-functionality": "node scripts/check-demo-functionality.mjs",
    "check:demo-interactions": "node scripts/check-demo-interactions.mjs",
    "check:local-data": "python scripts/check_cfs_local_data.py",
    "check:local-apis": "node scripts/check-local-apis.mjs",
    "check:local-interactions": "node scripts/check-local-interactions.mjs",
    "check:local-presentation": "node scripts/check-local-presentation.mjs",
    "check:presentation": "node scripts/check-presentation.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arcgis/core": "^5.0.19",
    "@azure/msal-browser": "^4.30.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright-core": "1.62.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
