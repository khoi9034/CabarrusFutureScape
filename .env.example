# Frontend-only public settings.
# These values are bundled into the browser. Do not put secrets here.

# Local Real Data Mode:
NEXT_PUBLIC_CFS_RUNTIME_MODE=local
NEXT_PUBLIC_CFS_DATA_PROVIDER=local_api
NEXT_PUBLIC_CFS_AUTH_MODE=local_dev
NEXT_PUBLIC_CFS_AI_PROVIDER=none
NEXT_PUBLIC_CFS_ARTIFACT_PROVIDER=local_file
NEXT_PUBLIC_CFS_JOB_PROVIDER=inline
NEXT_PUBLIC_CFS_API_BASE_URL=http://127.0.0.1:8000

# Portfolio Demo Mode (public Vercel site, no backend/database required):
# NEXT_PUBLIC_CFS_RUNTIME_MODE=demo
# NEXT_PUBLIC_CFS_DATA_PROVIDER=static
# NEXT_PUBLIC_CFS_AUTH_MODE=off
# NEXT_PUBLIC_CFS_AI_PROVIDER=none
# NEXT_PUBLIC_CFS_ARTIFACT_PROVIDER=public_static
# NEXT_PUBLIC_CFS_JOB_PROVIDER=inline

# ArcGIS MapView always starts with same-origin Cabarrus context, then adds the
# SDK OpenStreetMap layer. Enterprise deployments may instead configure one
# approved credential-free HTTPS tile host with {z}/{x}/{y} or
# {level}/{col}/{row} placeholders.
# NEXT_PUBLIC_CFS_BASEMAP_URL_TEMPLATE=https://tiles.example.gov/{z}/{x}/{y}.png
NEXT_PUBLIC_CFS_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors

# Future enterprise example (requires the public OIDC identifiers below):
# NEXT_PUBLIC_CFS_RUNTIME_MODE=enterprise
# NEXT_PUBLIC_CFS_DATA_PROVIDER=enterprise_api
# NEXT_PUBLIC_CFS_AUTH_MODE=oidc
# NEXT_PUBLIC_CFS_AI_PROVIDER=none
# NEXT_PUBLIC_CFS_ARTIFACT_PROVIDER=object_storage
# NEXT_PUBLIC_CFS_JOB_PROVIDER=external_worker
# NEXT_PUBLIC_CFS_API_BASE_URL=https://<render-backend-service>.onrender.com

# Azure/Vercel Preview with Microsoft Entra.
# These are public identifiers only; never add tokens, client secrets, or staging
# access tokens to NEXT_PUBLIC_ variables.
# NEXT_PUBLIC_CFS_ENTRA_TENANT_ID=<tenant-id>
# NEXT_PUBLIC_CFS_ENTRA_CLIENT_ID=<spa-client-id>
# NEXT_PUBLIC_CFS_ENTRA_API_SCOPE=api://<api-client-id>/CFS.Access

# Legacy compatibility only; prefer the canonical settings above:
# NEXT_PUBLIC_CFS_DEPLOYMENT_MODE=live
# NEXT_PUBLIC_USE_BACKEND_API=true
